@page
@model RazorPagesApp.Pages.Administration.AdminAuthorizeModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Авторизация";
    ViewData["css"] = "administration/admin_authorize.css";
}

<main class="main-container">
    <div class="form-wrapper">
        <form method="post" asp-page="AdminAuthorize">
            <div class="text-wrapper text-style">
                Авторизация для администратора:
            </div>
            <div class="red warning-text-wrapper text-style">
                @Model.Info
            </div>
            <div class="input-box">
                <input class="text-input input-size text-style" type="text" required name="Login" placeholder="Логин"/>
            </div>
            <div class="input-box">
                <input class="text-input input-size text-style" type="password" required name="Password" placeholder="Пароль" />
            </div>

            <input class="button-input" type="submit" value="Принять" />
        </form>
    </div>
    
</main>