@using Core.UserProgressFeatures
@using Core.Users
@using Core.Users.Services
@using Microsoft.AspNetCore.Components.Web
@using Core.Questions
@using System.Security.Claims
@using System.Timers

@inject NavigationManager NavigationManager
@inject IUserRepository UserRepository
@inject IHttpContextAccessor HttpContextAccessor

@if (Questions.Count != 0)
{
    <div class="info-wrapper text-style">
        <div class="question-wrapper ">
            Вопрос @(CurrentQuestionIndex + 1):

            @Questions[CurrentQuestionIndex].Text
        </div>
        <div id="time-panel" class="time-panel">
            <i class='bx bx-timer size-time-icon'></i>&nbsp<span id="time">@TimeLeft</span>
        </div>
    </div>

    <div>
        <textarea 
            id="answerinput"
            class="text-style" 
            @bind="Answer" 
            name="Answer" 
            cols="50" 
            rows="3" 
            placeholder="Ответ"
            required />

        <input hidden name="WasSearched" value="0" />
        <input hidden name="StartTime" value="0" />
        <input hidden name="EndTime" value="0" />
        <input id="time-to-answer-input" hidden name="TimeToAnswer" value="40" />
        <input id="timeout-to-answer-input" hidden name="TimeOutToAnswer" value="20" />

        <div class="button-wrapper">
            <div class="button-box">
                <button 
                    class="button left-button-radius text-style" 
                    @onclick="OnNextButtonClicked">
                    Далее
                </button>
            </div>
            <div class="button-box">
                <button 
                    class="button right-button-radius text-style" 
                    type="button"
                    @onclick="OnSearchButtonClicked"
                    id="SearchButton">
                    <i class='bx bx-search' />
                    Поиск в интернет
                </button>
            </div>
        </div>
    </div>
}
else
{
    <p>Странно. Но вопросов к Вам нет</p>
    <a href="">Уйти отсюда</a>
}

@code {
    [Parameter]
    public List<Question> Questions { get; set; } = null!;

    private int CurrentQuestionIndex { get; set; }

    private List<string> Answers { get; set; } = new();
    private List<bool> SearchStatuses { get; set; } = new();

    private string Answer { get; set; } = string.Empty;
    private bool WasSearch { get; set; } = false;
    private DateTime StartTime { get; set; }
    private DateTime EndTime { get; set; }

    private Timer _timer = null!;
    private int TimeLeft = 5;
    private bool quizStopped = false;

    protected override void OnInitialized()
    {
        _timer = new Timer(1000);
        _timer.Elapsed += ChangeTime;
        _timer.Start();

        StartTime = DateTime.Now;
    }

    private void ResetAndStartTimer()
    {
        if (!quizStopped)
        {
            TimeLeft = 5;
            _timer.Start();
        }
    }

    private async void ChangeTime(object? sender, ElapsedEventArgs e)
    {
        if (!quizStopped)
        {
            TimeLeft--;

            if (TimeLeft == 0)
            {
                _timer.Stop();
                await OnNextButtonClicked();
                ResetAndStartTimer();
            }

            await InvokeAsync(() => StateHasChanged());
        }
    }

    private void OnSearchButtonClicked()
    {
        SearchStatuses.Add(true);
    }

    private async Task OnNextButtonClicked()
    {
        Answers.Add(Answer);

        ResetAndStartTimer();

        if (IsLastQuestion)
        {
            _timer.Stop();
            quizStopped = true;
            var id = await SaveResuts();

            if (id == Guid.Empty)
                return;

            NavigationManager.NavigateTo($"/quiz/result?id={id.ToString()}", true);

            return;
        }

        CurrentQuestionIndex++;

        Answer = "";
    }

    private bool IsLastQuestion => Questions.Count == CurrentQuestionIndex + 1;

    private async Task<Guid> SaveResuts()
    {
        if (HttpContextAccessor.HttpContext is null)
        {
            return Guid.Empty;
        }

        var currentUser = HttpContextAccessor.HttpContext!.User;

        var userProgress = new UserProgress()
        {
            Id = Guid.NewGuid(),
            WasSearched = Enumerable.Repeat(false, Questions.Count).ToList(),
            Answers = Answers.Select(el => el.Trim()).ToList(),
            AnswerStartDateTime = Enumerable.Repeat(DateTime.Now, Questions.Count).ToList(),
            AnswerEndDateTime = Enumerable.Repeat(DateTime.Now, Questions.Count).ToList(), 
        };

        userProgress.CountRightAnswers(Questions);

        var userId = Guid.NewGuid();

        var user = new User()
        {
            Id = userId,
            Age = int.Parse(currentUser.FindFirst(ClaimTypes.DateOfBirth)?.Value ?? "0"),
            Name = currentUser.FindFirst(ClaimTypes.GivenName)?.Value ?? "null",
            Sername = currentUser.FindFirst(ClaimTypes.Surname)?.Value ?? "null",
            FatherName = currentUser.FindFirst(ClaimTypes.Surname)?.Value ?? "null",
            Sex = (Sex)Enum.Parse(typeof(Sex), currentUser.FindFirst(ClaimTypes.Gender)?.Value ?? "Man"),
            Progress = userProgress
        };

        await UserRepository.AddUser(user);

        return userId;
    }
}
