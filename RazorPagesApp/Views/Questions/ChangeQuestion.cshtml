@using QuiApp.WebMVC.Controllers.Questions.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model QuestionDto
@{
    ViewData["Title"] = "Изменение вопроса";
    ViewData["css"] = "administration/question.css";
}

<main>
    <a class="button1 text-style" href="/Administration/Questions"><i class='bx bx-chevron-left'></i>Отмена</a>

    <div class="info-wraper text-style">
        <i class='bx bx-info-circle'></i>
        Поля можно растянуть вниз. Ответы добавляются через enter.
    </div>

    <form method="post" asp-controller="questions" asp-action="change">
        <input type="number" hidden name="index" value="@(ViewData["index"])" />

        <div class="text-input text-style">
            <lable class="text-input-label" for="text">
                Вопрос
            </lable>
            <textarea class="text-style" id="text" required name="text" rows="2" placeholder="Вопрос?">@Model.Text</textarea>
        </div>

        <div class="answers-input text-style">
            <lable class="text-input-label" for="answers">
                Ответы
            </lable>
            <textarea class="text-style" id="answers" required name="answers" rows="10" placeholder="Ответы">@string.Join("\n", Model.Answers)</textarea>
        </div>

        <input asp-for="Id" value="@Model.Id" hidden />

        <input class="button2 text-style" type="submit" value="Изменить" />
    </form>
</main>

