@using QuiApp.WebMVC.Controllers.Users.Models

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model UserLoginDto;

@{
    ViewData["Title"] = "Регистрация";
    ViewData["css"] = "quiz/authentication.css";
    Layout = "../Shared/_MainLayout.cshtml";
}

<div class="container-xxl" style="height: 100%;">
    <div class="card px-4 py-3 mx-auto" style="width: 95%; margin-top: 4%;">
        <h4 class="card-title">
            Для участия в тестирование оставьте о себе данные
        </h4>
        <form method="post" asp-action="RegisterUser" asp-controller="Users">
            <div class="mb-2">
                <label for="exampleInputEmail1" class="form-label">Фамилия</label>
                <input type="text" class="form-control" required asp-for="Sername">
            </div>
            <div class="mb-2">
                <label for="exampleInputEmail1" class="form-label">Имя</label>
                <input type="text" class="form-control" required asp-for="Name">
            </div>
            <div class="mb-2">
                <label for="exampleInputEmail1" class="form-label">Отчество</label>
                <input type="text" class="form-control" asp-for="FatherName" placeholder="необязательно">
            </div>
            <div class="mb-2">
                <label for="exampleInputEmail1" class="form-label">Возраст</label>
                <input type="number" class="form-control" asp-for="Age" value="18" required>
            </div>
            <div class="mb-2">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Sex" value="0" name="flexRadioDefault" id="flexRadioDefault1" checked>
                    <label class="form-check-label" for="flexRadioDefault1">
                        Мужчина
                    </label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Sex" value="1" name="flexRadioDefault" id="flexRadioDefault2">
                    <label class="form-check-label" for="flexRadioDefault2">
                        Женщина
                    </label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mb-2">Принять</button>
        </form>
    </div>
</div>
