@using QuiApp.WebMVC.Controllers.Quiz.Models

@model InfoDataDto

@{
    Layout = "../Shared/_MainLayout.cshtml";
}

<div class="card m-2">
    <div class="card-header">
        @Model.QuestionPackName
    </div>
    <div class="card-body">
        <p class="card-text">@Model.InfoMessage</p>
    </div>
</div>

<div class="card m-2">
    <div class="card-header">
        Инструкция:
    </div>
    <div class="card-body">
        <p class="card-text">@Model.InstructionMessage</p>
        <a href="@Url.Action("QuizView", "Quiz")" class="btn btn-primary">Начать тестирование</a>
    </div>
</div>