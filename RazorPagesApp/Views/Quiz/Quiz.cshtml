@using QuiApp.WebMVC.Components
@using QuiApp.WebMVC.Controllers.Quiz.Models

@model QuizDataDto

@{
    ViewData["css"] = "quiz/question.css";
    ViewData["Title"] = Model.QuestionPackName;
    Layout = "../Shared/_MainLayout.cshtml";
}

@(await Html.RenderComponentAsync<QuestionComponent>(
    RenderMode.ServerPrerendered, 
    new { Questions = Model.Questions }))
