@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["css"] = "quiz/question.css";
    ViewData["Title"] = "Тест";
}

<main class="main-container">
    <div class="info-wrapper text-style">
        <div class="question-wrapper ">
            Вопрос @(Model.Progress.CurrentQuestion + 1):

            @Model.Question.Text
        </div>
        <div id="time-panel" class="time-panel">
            <i class='bx bx-timer size-time-icon'></i>&nbsp<span id="time"><span>
        </div>
    </div>
    <div class="form-wrapper">
        <form id="form" method="post" name="Form1">
            <textarea id="answerinput" class="text-style" required name="Answer" cols="50" rows="3" placeholder="Ответ"></textarea>

            <input hidden name="WasSearched" value="0" />
            <input hidden name="StartTime" value="0" />
            <input hidden name="EndTime" value="0" />
            <input id="time-to-answer-input" hidden name="TimeToAnswer" value="40" />
            <input id="timeout-to-answer-input" hidden name="TimeOutToAnswer" value="20" />

            <div class="button-wrapper">
                <div class="button-box">
                    <input id="sub-button" class="button left-button-radius text-style" type="submit" value="Далее" />
                </div>
                <div class="button-box">
                    <button class="button right-button-radius text-style" type="button" id="SearchButton"><i class='bx bx-search'></i>Поиск в интернет</button>
                </div>
            </div>
        </form>
    </div>
    <script src="~/js/TimeControl.js"></script>
    <script src="~/js/TimeCounter.js"></script>
</main>