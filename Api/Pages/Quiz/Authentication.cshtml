@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model RazorPagesApp.Pages.Quiz.AuthenticationModel
@{
    ViewData["Title"] = "Регистрация";
    ViewData["css"] = "quiz/authentication.css";
}

<main class="main-container">
    <div class="info-wrapper">
        <div class="info-inside text-style">
            <i class='bx bx-info-circle'></i>
            Перед Вами тест для исследования особенностей памяти человека.
            Он не направлен на оценку Ваших знаний,
            поэтому просим внимательно ознакомиться с инструкцией и следовать ей.
        </div>
    </div>
    
    <div class="form-wrapper">
        <p class="form-container__info text-style bold-text">
            О Вас
        </p>
        <form method="post" asp-page="Authentication" asp-page-handler="Authorize">
            <div class="input-box text-style">
                <label>
                        Фамилия
                </label>
                <input class="text-input" type="text" required asp-for="User.Sername" />
            </div>
            <div class="input-box text-style">
                <label>
                    Имя
                </label>
                <input class="text-input" type="text" required asp-for="User.Name" />
            </div>
            <div class="input-box text-style">
                <label>
                    Отчество
                </label>
               <input class="text-input" type="text" asp-for="User.FatherName" placeholder="необязательно"/>
            </div>
            <div class="input-box text-style">
                <label>
                    Возраст
                </label>
                <input class="text-input" type="number" required value="18" asp-for="User.Age" />
            </div>
            <div class="radio-box text-style">
                <input class="radio-button-input" id="male" type="radio" name="Sex" checked value="0" />
                <label class="radio-button-label" for="male">Мужчина</label>
                <input class="radio-button-input" id="female" type="radio" name="Sex" value="1" />
                <label class="radio-button-label" for="female">Женщина</label>
                
             </div>
            <div class="button-wrapper">
                <input class="submit-input" type="submit" value="Отправить" />
            </div>
        </form>
    </div>
</main>